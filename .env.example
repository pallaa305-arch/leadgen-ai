# Core AI / app URLs
GEMINI_API_KEY="your_gemini_api_key"
APP_URL="https://your-public-app-url.com"
APP_BASE_URL="https://your-public-backend-url.com"
CLIENT_APP_URL="https://your-frontend-url.com"
VITE_API_PROXY_TARGET="http://localhost:8787"

# Agency identity
AGENCY_NAME="LeadGen AI"
AGENCY_REPLY_TO_EMAIL="owner@youragency.com"

# Email delivery (Resend)
RESEND_API_KEY="re_xxx"
RESEND_FROM_EMAIL="LeadGen AI <sales@yourdomain.com>"

# Stripe payments
STRIPE_SECRET_KEY="sk_live_or_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# Twilio outbound calls
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_PHONE_NUMBER="+15551234567"

# ElevenLabs AI Agent
ELEVENLABS_API_KEY="your_elevenlabs_api_key"
ELEVENLABS_AGENT_ID="your_elevenlabs_agent_id"


# Vercel deployment for generated client sites
VERCEL_TOKEN="your_vercel_token"
VERCEL_TEAM_ID=""
VERCEL_PROJECT_PREFIX="leadgen-client"
VERCEL_ALIAS_DOMAIN=""

# Firebase Admin credentials for webhook updates
FIREBASE_PROJECT_ID="your_firebase_project_id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@your-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
